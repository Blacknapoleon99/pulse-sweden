{
  "name": "tryggpuls",
  "version": "2.0.1",
  "description": "TryggPuls – svenska myndighetskällor, familj och obekräftade användarrapporter",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check-syntax.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/timestamp.test.mjs tests/buffer.test.mjs tests/geometry.test.mjs tests/bra.test.mjs tests/categorize.test.mjs tests/feeds.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:mobile": "node --test tests/mobile-state.test.ts tests/incident-summary.test.ts",
    "test:postgres": "node --test tests/family-postgres.test.mjs tests/community-postgres.test.mjs",
    "check:all": "node scripts/check-syntax.mjs",
    "test:feeds": "node --test tests/feed-store.test.ts",
    "check:render": "node scripts/validate-render.mjs",
    "migrate": "node scripts/migrate.mjs",
    "test:restore": "node scripts/rehearse-restore.mjs",
    "package:cloud": "node scripts/package-cloud-release.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1143.0",
    "@sentry/node": "^11.1.0",
    "fast-xml-parser": "^5.11.1",
    "fflate": "^0.8.3",
    "pg": "^8.16.3",
    "proj4": "^2.22.0",
    "sharp": "^0.35.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "pg-mem": "^3.0.14",
    "yaml": "^2.9.1"
  }
}
