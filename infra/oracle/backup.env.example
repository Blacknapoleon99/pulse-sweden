# Store the real file at /etc/tryggpuls/backup.env (root:tryggpuls, mode 0640).
# Customer secret keys for a private, dedicated OCI Object Storage bucket.
BACKUP_ENCRYPTION_KEY=
BACKUP_S3_ENDPOINT=https://YOUR_NAMESPACE.compat.objectstorage.eu-frankfurt-1.oraclecloud.com
BACKUP_S3_REGION=eu-frankfurt-1
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=tryggpuls/
BACKUP_KEEP=7
BACKUP_MAX_BYTES=2147483648
