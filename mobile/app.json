{
  "expo": {
    "name": "Trygg-Puls",
    "slug": "tryggpuls",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/trygg-puls-icon.png",
    "userInterfaceStyle": "light",
    "description": "Svensk trygghetsinformation, familj och obekräftade användarobservationer.",
    "ios": {
