        {
          "image": "./assets/trygg-puls-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#F8FAFD"
        }
      ],
      "expo-video"
    ],
    "extra": {
      "eas": {
        "projectId": "37c14594-4143-4223-8703-656752df2474"
      }
    },
    "owner": "kevin200",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/37c14594-4143-4223-8703-656752df2474"
    }
  }
