# Optional CARTO key. Requests are proxied; the key is never sent to the browser.
CARTO_BASEMAP_API_KEY=
# Optional Trafikverket API key. Stored and used by the server only.
TRAFIKVERKET_API_KEY=
# Private bearer token for the reviewed-zone admin page; use a long random value.
ZONE_ADMIN_TOKEN=
# Family accounts require PostgreSQL in production. Local development uses an in-memory test database.
DATABASE_URL=
# Generate once with `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Show preview limitation warning when using temporary/free hosting resources.
FAMILY_PREVIEW_MODE=false
# For higher traffic, configure your own services / contracted providers.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
WALKING_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
DRIVING_ROUTER_URL=https://routing.openstreetmap.de/routed-car
UPSTREAM_USER_AGENT=TryggPuls/2.1
