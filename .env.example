# Optional CARTO key. Requests are proxied; the key is never sent to the browser.
CARTO_BASEMAP_API_KEY=
# Optional Trafikverket API key. Stored and used by the server only.
TRAFIKVERKET_API_KEY=
# Private bearer token for the reviewed-zone admin page; use a long random value.
ZONE_ADMIN_TOKEN=
# Optional per-staff credentials, e.g. [{"id":"editor-1","token":"...","role":"editor"},{"id":"reviewer-1","token":"...","role":"reviewer"}]. Never expose in EXPO_PUBLIC_*.
ZONE_ADMIN_TOKENS_JSON=
# BankID RP-API v6.0. Disabled until a BankID agreement, PFX certificate, and
# keyed identifier hash secret are supplied to the server (never EXPO_PUBLIC_*).
BANKID_ENV=test
BANKID_CERT_PATH=
BANKID_CERT_PASSPHRASE=
BANKID_CA_CERT_PATH=
BANKID_USER_HASH_KEY=
BANKID_TRUST_PROXY=false
BANKID_RETURN_URL=
# Family accounts require PostgreSQL in production. Local development uses an in-memory test database.
DATABASE_URL=
# Generate once with `node -e "console.log(require('web-push').generateVAPIDKeys())"`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Show preview limitation warning when using temporary/free hosting resources.
FAMILY_PREVIEW_MODE=false
# For higher traffic, configure your own services / contracted providers.
GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
WALKING_ROUTER_URL=https://routing.openstreetmap.de/routed-foot
DRIVING_ROUTER_URL=https://routing.openstreetmap.de/routed-car
UPSTREAM_USER_AGENT=TryggPuls/2.1
# Optional Foundry read-only integration. Keep disabled until an approved
# summary-output dataset is populated and reviewed in the pilot.
FOUNDRY_BASE_URL=
FOUNDRY_CLIENT_ID=
FOUNDRY_CLIENT_SECRET=
FOUNDRY_SUMMARIES_DATASET_RID=
FOUNDRY_SUMMARIES_BRANCH=master
FOUNDRY_SUMMARIES_ENABLED=false
FOUNDRY_SUMMARIES_MAX_AGE_MS=21600000

# Community publication is disabled until a staffed, approved rollout.
APP_ENV=development
TRYGGPULS_LOAD_ENVFILE=true
PUBLIC_APP_URL=
SUPPORT_EMAIL=
MODERATION_EMAIL=
OPERATIONS_EMAIL=
COMMUNITY_PUBLISHING_ENABLED=false
COMMUNITY_LAUNCH_APPROVED=false
MODERATION_STAFFED=false
COMMUNITY_BLOCKED_TERMS_JSON=[]
# Private S3 bucket, Block Public Access ON; never put these keys in Expo.
AWS_REGION=eu-north-1
COMMUNITY_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESEND_API_KEY=
EMAIL_FROM=
NATIVE_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
SENTRY_DSN=
IOS_APP_ID=
ANDROID_PACKAGE=
ANDROID_SHA256_FINGERPRINTS_JSON=[]
